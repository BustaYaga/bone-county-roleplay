echo Executing Server Config...
lanmode 0
rcon_password CHANGE_ME
maxplayers 50
port 48752
hostname BCRP development server
gamemode0 Compile
filterscripts
plugins crashdetect streamer sscanf mysql discord-connector samp-compat
announce 0
chatlogging 0
weburl example.invalid
onfoot_rate 80
incar_rate 80
weapon_rate 40
stream_distance 300.0
stream_rate 1000
maxnpc 10
logtimeformat [%H:%M:%S]
language English
useartwork 0
sleep 1
mtu 1400